# agy2api 的环境变量（KEY=VALUE，# 开头是注释）。复制后填上真实值，不要入库：
#   Docker Compose：复制成 compose.yaml 同目录的 .env
#   systemd（手动安装）：复制成 /etc/agy2api/env，权限 600
# 一键安装会自己生成安装目录里的 .env。
# 全部变量见 docs/deploy.md 的"环境变量"。

# 管理端口令，必填。公网部署用足够长的随机串，如 openssl rand -base64 24 的输出。
AGY2API_ADMIN_PASSWORD=

# 只允许这些客户端 IP 访问管理端（逗号分隔的 IP 或 CIDR），网关接口不受限。公网部署建议设上。
# AGY2API_ADMIN_ALLOW=203.0.113.7,198.51.100.0/24

# 可信反向代理：只有直连的对端在其中时才按 X-Forwarded-For 取客户端 IP。默认回环和内网地址，
# 反代和网关在同一台机器或同一个 Docker 网络时不用改。
# AGY2API_TRUSTED_PROXIES=127.0.0.1

# 凭据加密密钥。留空时在数据目录生成 agy2api.key（要和数据库一起备份）。
# AGY2API_ENCRYPTION_KEY=

# 在线升级：每天和打开管理端时查 GitHub 上的新版本，管理端可以一键升级。off 关闭（不连 GitHub）。
# AGY2API_UPDATE=off

# 日志时区（默认 UTC）和级别。
# TZ=Asia/Shanghai
# AGY2API_LOG_LEVEL=info
